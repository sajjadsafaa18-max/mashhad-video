<!doctype html>
<html lang="ar">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>مشهد</title>

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Reem+Kufi:wght@500;700&family=IBM+Plex+Sans+Arabic:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap">
<style>
:root {
  --bg: #F1F4F2;
  --surface: #FFFFFF;
  --ink: #14211D;
  --muted: #5B6B65;
  --line: #D3DCD8;
  --accent: #0B7A63;
  --accent-ink: #FFFFFF;
  --monitor: #0E1714;
  --monitor-ink: #DDE9E4;
  --warn: #B4540A;
  --font-display: "Reem Kufi", "Segoe UI", Tahoma, sans-serif;
  --font-body: "IBM Plex Sans Arabic", "Segoe UI", Tahoma, sans-serif;
  --font-mono: "IBM Plex Mono", ui-monospace, Menlo, Consolas, monospace;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #0D1512; --surface: #15201C; --ink: #E4EEE9; --muted: #92A59D; --line: #25352F;
    --accent: #3FCBA6; --accent-ink: #06231B; --monitor: #070C0A; --monitor-ink: #DDE9E4; --warn: #F0A25E;
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #0D1512; --surface: #15201C; --ink: #E4EEE9; --muted: #92A59D; --line: #25352F;
  --accent: #3FCBA6; --accent-ink: #06231B; --monitor: #070C0A; --monitor-ink: #DDE9E4; --warn: #F0A25E;
  color-scheme: dark;
}
* { box-sizing: border-box; }
body {
  background: var(--bg); color: var(--ink);
  font-family: var(--font-body); font-size: 16px; line-height: 1.7;
  padding-block: 20px 48px;
  padding-left: max(16px, env(safe-area-inset-left, 0px));
  padding-right: max(16px, env(safe-area-inset-right, 0px));
}
.wrap { max-width: 1120px; margin: 0 auto; }
header.top { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-bottom: 18px; border-bottom: 1px solid var(--line); }
.brand { font-family: var(--font-display); font-size: 30px; font-weight: 700; letter-spacing: 0; line-height: 1; display: flex; align-items: center; gap: 10px; }
.brand i { width: 14px; height: 14px; border-radius: 50%; background: var(--accent); display: inline-block; }
.top small { color: var(--muted); font-size: 14px; }
h1 { font-family: var(--font-display); font-weight: 700; font-size: clamp(28px, 5vw, 44px); line-height: 1.25; margin: 28px 0 6px; text-wrap: balance; }
.lede { color: var(--muted); max-width: 60ch; margin: 0 0 24px; }

.desk { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 20px; align-items: start; }
@media (max-width: 860px) { .desk { grid-template-columns: minmax(0, 1fr); } }

.panel { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 18px; display: flex; flex-direction: column; gap: 18px; min-width: 0; }
label.field, .field-title { font-weight: 600; font-size: 15px; display: block; margin-bottom: 8px; }
textarea {
  width: 100%; min-height: 128px; resize: vertical; padding: 12px 14px;
  font: inherit; color: var(--ink); background: var(--bg);
  border: 1px solid var(--line); border-radius: 8px; line-height: 1.7;
}
textarea::placeholder { color: var(--muted); }
:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.row-meta { display: flex; justify-content: space-between; color: var(--muted); font-size: 13px; margin-top: 6px; }
.chips { display: flex; flex-wrap: wrap; gap: 8px; }
.chip {
  font: inherit; font-size: 14px; color: var(--ink); background: var(--bg);
  border: 1px solid var(--line); border-radius: 999px; padding: 6px 14px; cursor: pointer; min-height: 38px;
}
.chip[aria-pressed="true"] { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); font-weight: 600; }
.chip .m { font-family: var(--font-mono); font-size: 13px; direction: ltr; display: inline-block; }
.go {
  font: inherit; font-weight: 600; font-size: 17px; background: var(--accent); color: var(--accent-ink);
  border: 0; border-radius: 8px; padding: 13px 20px; cursor: pointer; width: 100%;
}
.go:disabled { opacity: .6; cursor: progress; }
.fine { color: var(--muted); font-size: 13px; margin: 0; }

.monitor-wrap { display: flex; flex-direction: column; gap: 10px; min-width: 0; }
.monitor { background: var(--monitor); border-radius: 10px; padding: 12px; display: flex; flex-direction: column; gap: 10px; border: 1px solid var(--line); }
.screen-box { display: grid; place-items: center; background: #000; border-radius: 6px; min-height: 240px; padding: 0; overflow: hidden; }
.screen { position: relative; width: 100%; max-width: 100%; aspect-ratio: 16 / 9; margin: 0 auto; background: #0a0f0d; }
.screen canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
.slate { position: absolute; inset: 0; display: grid; place-items: center; text-align: center; padding: 16px; color: var(--monitor-ink); font-size: 15px; }
.slate b { display: block; font-family: var(--font-display); font-size: 22px; margin-bottom: 4px; }
.badge { position: absolute; top: 8px; right: 8px; background: rgba(0,0,0,.6); color: #FFD9A8; font-size: 12px; padding: 2px 10px; border-radius: 999px; }
.tc-bar { display: flex; justify-content: space-between; align-items: center; gap: 10px; color: var(--monitor-ink); font-family: var(--font-mono); font-size: 13px; direction: ltr; }
.tc-bar .tc { font-size: 18px; font-weight: 500; letter-spacing: .04em; }
.prog { height: 4px; background: #24332D; border-radius: 2px; overflow: hidden; direction: ltr; }
.prog span { display: block; height: 100%; width: 0; background: var(--accent); }
.status { color: var(--monitor-ink); font-size: 14px; min-height: 1.7em; }
.note { border: 1px dashed var(--line); border-radius: 8px; padding: 10px 14px; font-size: 14px; color: var(--muted); }
.note b { color: var(--warn); }

h2 { font-family: var(--font-display); font-size: 24px; margin: 36px 0 12px; }
.strip { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px; }
.frame { text-align: right; font: inherit; color: var(--ink); background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 0; cursor: pointer; overflow: hidden; min-width: 0; }
.frame .thumb { height: 76px; display: block; }
.frame .txt { display: block; padding: 10px 12px 12px; font-size: 14px; line-height: 1.6; }
.frame .nm { display: block; font-weight: 600; font-size: 14px; margin-bottom: 2px; }
.frame:hover { border-color: var(--accent); }
footer { margin-top: 36px; color: var(--muted); font-size: 13px; }
@media (prefers-reduced-motion: reduce) { * { transition: none !important; animation: none !important; } }

html,body{margin:0}
.screen video{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;background:#000}
</style>
</head>
<body>

<div dir="rtl" lang="ar" class="wrap">
  <header class="top">
    <div class="brand"><i></i>مشهد</div>
    <small>فيديو بالذكاء الاصطناعي</small>
  </header>

  <h1>اكتب المشهد، وشوفه فيديو</h1>
  <p class="lede">صِف اللقطة اللي براسك، اختار الأسلوب والمدة، ومشهد يحوّلها إلى فيديو قصير.</p>

  <div class="desk">
    <section class="panel" aria-label="إعدادات الفيديو">
      <div>
        <label class="field" for="prompt">وصف المشهد</label>
        <textarea id="prompt" maxlength="400" placeholder="مثال: قارب صغير يعبر نهر دجلة وقت الغروب، والنخيل يتمايل على الضفة">قارب صغير يعبر نهر دجلة وقت الغروب، والنخيل يتمايل على الضفة</textarea>
        <div class="row-meta"><span>كل ما كان الوصف أدق، كانت اللقطة أقرب لخيالك</span><span id="count" style="font-family:var(--font-mono)">0 / 400</span></div>
      </div>

      <div>
        <span class="field-title" id="t-style">الأسلوب</span>
        <div class="chips" role="group" aria-labelledby="t-style" id="styles">
          <button class="chip" type="button" data-v="cine" aria-pressed="true">سينمائي</button>
          <button class="chip" type="button" data-v="real" aria-pressed="false">واقعي</button>
          <button class="chip" type="button" data-v="anime" aria-pressed="false">أنمي</button>
          <button class="chip" type="button" data-v="three" aria-pressed="false">ثلاثي الأبعاد</button>
        </div>
      </div>

      <div>
        <span class="field-title" id="t-ratio">الأبعاد</span>
        <div class="chips" role="group" aria-labelledby="t-ratio" id="ratios">
          <button class="chip" type="button" data-v="16/9" aria-pressed="true"><span class="m">16:9</span> أفقي</button>
          <button class="chip" type="button" data-v="9/16" aria-pressed="false"><span class="m">9:16</span> ريلز وتيك توك</button>
          <button class="chip" type="button" data-v="1/1" aria-pressed="false"><span class="m">1:1</span> مربع</button>
        </div>
      </div>

      <div>
        <span class="field-title" id="t-dur">المدة</span>
        <div class="chips" role="group" aria-labelledby="t-dur" id="durs">
          <button class="chip" type="button" data-v="5" aria-pressed="true">5 ثواني</button>
        </div>
      </div>

      <button class="go" id="go" type="button">ولّد الفيديو</button>
      <p class="fine" id="calc"></p>
    </section>

    <section class="monitor-wrap" aria-label="شاشة المعاينة">
      <div class="monitor">
        <div class="screen-box">
          <div class="screen" id="screen">
            <canvas id="cv" width="640" height="360"></canvas>
            <video id="vid" controls playsinline loop hidden></video>
            <div class="slate" id="slate"><div><b>الشاشة فاضية</b>اكتب وصف المشهد واضغط ولّد</div></div>
            <span class="badge" id="badge" hidden>معاينة تجريبية</span>
          </div>
        </div>
        <div class="prog" aria-hidden="true"><span id="bar"></span></div>
        <div class="tc-bar"><span class="tc" id="tc">00:00:00:00</span><span id="fps">24 fps</span></div>
        <div class="status" id="status" role="status">جاهز</div>
      </div>
      <p class="note">الفيديو يتولد عبر Luma ويستغرق عادة من نص دقيقة إلى دقيقتين. لا تغلق الصفحة أثناء التوليد.</p>
    </section>
  </div>

  <h2>أفكار تبدأ منها</h2>
  <div class="strip" id="ideas"></div>

  <footer>مشهد · يعمل بـ Luma</footer>
</div>

<script>
(function () {
  var FPS = 24;
  var state = { style: 'cine', ratio: '16/9', dur: 5, running: false, raf: 0 };
  var STYLES = {
    cine:  { name: 'سينمائي',      sky: ['#1b2a41', '#e08a4b'], sun: '#ffd9a8', land: ['#0f1a24', '#16283a'], grain: 0.10 },
    real:  { name: 'واقعي',        sky: ['#6fa8d6', '#e9f1f7'], sun: '#fff6d6', land: ['#3f6b4f', '#2e5440'], grain: 0.02 },
    anime: { name: 'أنمي',         sky: ['#ff9fb2', '#ffe3a3'], sun: '#fff', land: ['#4d6fd1', '#3a55a8'], grain: 0 },
    three: { name: 'ثلاثي الأبعاد', sky: ['#5b6cff', '#9be7ff'], sun: '#fff1a8', land: ['#f2a65a', '#d98443'], grain: 0 }
  };
  var IDEAS = [
    { n: 'غروب على النهر', t: 'قارب صغير يعبر نهر دجلة وقت الغروب، والنخيل يتمايل على الضفة', s: 'cine', c: ['#1b2a41', '#e08a4b'] },
    { n: 'سوق قديم', t: 'سوق شعبي قديم في بغداد، ضوء الصباح يدخل من فتحات السقف والناس تمشي ببطء', s: 'real', c: ['#6fa8d6', '#e9f1f7'] },
    { n: 'قطة فضائية', t: 'قطة ترتدي بدلة فضاء تمشي على سطح القمر وتلاحق فراشة مضيئة', s: 'three', c: ['#5b6cff', '#9be7ff'] },
    { n: 'مطر على المدينة', t: 'مطر خفيف على شارع ليلي، انعكاس الأضواء على الأرض المبللة وسيارة تعبر بهدوء', s: 'cine', c: ['#0f1a24', '#3d5a80'] },
    { n: 'بنت الربيع', t: 'بنت تركض في حقل زهور وشعرها يتطاير مع الهواء، نسمة ربيع وشمس دافئة', s: 'anime', c: ['#ff9fb2', '#ffe3a3'] },
    { n: 'قهوة الصباح', t: 'فنجان قهوة يتصاعد منه البخار على طاولة خشبية جنب نافذة، لقطة قريبة', s: 'real', c: ['#8a5a3c', '#e8d2b8'] }
  ];

  var $ = function (id) { return document.getElementById(id); };
  var prompt = $('prompt'), cv = $('cv'), ctx = cv.getContext('2d');

  function updateCount() { $('count').textContent = prompt.value.length + ' / 400'; }
  function updateCalc() {
    $('calc').textContent = 'المخرج: ' + (state.dur * FPS) + ' إطار بسرعة ' + FPS + ' إطار بالثانية';
  }
  function tc(frame) {
    var f = frame % FPS, s = Math.floor(frame / FPS) % 60, m = Math.floor(frame / FPS / 60);
    var p = function (x) { return (x < 10 ? '0' : '') + x; };
    return '00:' + p(m) + ':' + p(s) + ':' + p(f);
  }

  function group(id, key, conv) {
    var box = $(id);
    box.addEventListener('click', function (e) {
      var b = e.target.closest('.chip'); if (!b) return;
      box.querySelectorAll('.chip').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
      state[key] = conv ? conv(b.dataset.v) : b.dataset.v;
      if (key === 'ratio') applyRatio();
      updateCalc();
    });
  }
  function setGroup(id, val) {
    $(id).querySelectorAll('.chip').forEach(function (x) { x.setAttribute('aria-pressed', x.dataset.v === val ? 'true' : 'false'); });
  }
  group('styles', 'style'); group('ratios', 'ratio'); group('durs', 'dur', Number);

  function applyRatio() {
    var parts = state.ratio.split('/'), w = +parts[0], h = +parts[1];
    var sc = $('screen');
    sc.style.aspectRatio = w + ' / ' + h;
    sc.style.maxWidth = (h > w ? '260px' : '100%');
    var cw = w >= h ? 640 : 360, ch = w >= h ? (w === h ? 640 : 360) : 640;
    cv.width = cw; cv.height = ch;
    drawFrame(0, false);
  }

  function drawFrame(t, live) {
    var S = STYLES[state.style], W = cv.width, H = cv.height;
    var g = ctx.createLinearGradient(0, 0, 0, H);
    g.addColorStop(0, S.sky[0]); g.addColorStop(1, S.sky[1]);
    ctx.fillStyle = g; ctx.fillRect(0, 0, W, H);
    var sunX = W * (0.25 + 0.5 * t), sunY = H * (0.58 - 0.18 * Math.sin(t * Math.PI));
    ctx.fillStyle = S.sun; ctx.beginPath(); ctx.arc(sunX, sunY, Math.min(W, H) * 0.09, 0, Math.PI * 2); ctx.fill();
    for (var layer = 0; layer < 2; layer++) {
      ctx.fillStyle = S.land[layer];
      ctx.beginPath(); ctx.moveTo(0, H);
      var base = H * (0.72 + layer * 0.1), off = t * W * (0.3 + layer * 0.5);
      for (var x = 0; x <= W; x += 8) {
        ctx.lineTo(x, base + Math.sin((x + off) / (60 - layer * 18)) * (10 + layer * 6));
      }
      ctx.lineTo(W, H); ctx.closePath(); ctx.fill();
    }
    var bx = W * (1.1 - 1.2 * t), by = H * 0.8 + Math.sin(t * 14) * 3;
    ctx.fillStyle = 'rgba(0,0,0,.55)';
    ctx.beginPath(); ctx.moveTo(bx - 26, by); ctx.lineTo(bx + 26, by); ctx.lineTo(bx + 16, by + 10); ctx.lineTo(bx - 16, by + 10); ctx.closePath(); ctx.fill();
    ctx.fillRect(bx - 1, by - 22, 2, 22);
    if (S.grain && live) {
      for (var i = 0; i < 120; i++) {
        ctx.fillStyle = 'rgba(255,255,255,' + (Math.random() * S.grain) + ')';
        ctx.fillRect(Math.random() * W, Math.random() * H, 1.5, 1.5);
      }
    }
  }

  function setStatus(s) { $('status').textContent = s; }

  function sleep(ms) { return new Promise(function (r) { setTimeout(r, ms); }); }
  async function runReal() {
    if (state.running) return;
    var text = prompt.value.trim();
    if (!text) { setStatus('اكتب وصف المشهد أول'); prompt.focus(); return; }
    state.running = true; cancelAnimationFrame(state.raf);
    var vid = $('vid');
    $('go').disabled = true; $('go').textContent = 'جاري التوليد...';
    $('slate').hidden = true; $('badge').hidden = true; vid.hidden = true; vid.removeAttribute('src');
    $('bar').style.width = '0%';
    var t0 = Date.now(), tick = 0;
    var anim = setInterval(function () {
      tick++; drawFrame((tick % 120) / 120, true);
      var secs = Math.floor((Date.now() - t0) / 1000);
      $('tc').textContent = tc(secs * FPS);
      $('bar').style.width = Math.min(92, secs * 1.2) + '%';
    }, 60);
    try {
      setStatus('أرسل الطلب...');
      var r = await fetch('/api/generate', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ prompt: text, style: state.style, ratio: state.ratio.replace('/', ':'), duration: state.dur })
      });
      var d = await r.json();
      if (!r.ok) throw new Error(d.error || 'تعذر إرسال الطلب');
      while (true) {
        await sleep(4000);
        var sr = await fetch('/api/status?id=' + encodeURIComponent(d.id));
        var s = await sr.json();
        if (!sr.ok) throw new Error(s.error || 'تعذر فحص الحالة');
        if (s.state === 'completed' && s.video) {
          clearInterval(anim);
          $('bar').style.width = '100%';
          vid.src = s.video; vid.hidden = false; vid.play().catch(function () {});
          setStatus('جاهز. اضغط على الفيديو للتشغيل.');
          break;
        }
        if (s.state === 'failed') throw new Error(s.reason || 'فشل التوليد');
        if (Date.now() - t0 > 300000) throw new Error('انتهى الوقت. جرب مرة ثانية.');
        setStatus('جاري التوليد... ' + Math.floor((Date.now() - t0) / 1000) + ' ثانية');
      }
    } catch (e) {
      clearInterval(anim);
      $('slate').hidden = false;
      setStatus('صار خطأ: ' + (e && e.message ? e.message : 'غير معروف'));
    } finally {
      clearInterval(anim);
      state.running = false; $('go').disabled = false; $('go').textContent = 'ولّد الفيديو';
    }
  }

  var box = $('ideas');
  IDEAS.forEach(function (it) {
    var b = document.createElement('button');
    b.type = 'button'; b.className = 'frame';
    b.innerHTML = '<span class="thumb" style="background:linear-gradient(180deg,' + it.c[0] + ',' + it.c[1] + ')"></span>' +
                  '<span class="txt"><span class="nm"></span><span class="d"></span></span>';
    b.querySelector('.nm').textContent = it.n;
    b.querySelector('.d').textContent = it.t;
    b.addEventListener('click', function () {
      prompt.value = it.t; state.style = it.s; setGroup('styles', it.s); updateCount();
      prompt.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
    box.appendChild(b);
  });

  prompt.addEventListener('input', updateCount);
  $('go').addEventListener('click', runReal);
  updateCount(); updateCalc(); applyRatio();
})();
</script>

</body>
</html>
